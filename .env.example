# CAN Protection Environment Variables Template
# Do NOT commit real secrets to version control.
# NEVER prefix server secrets with VITE_ or expose them to browser code.

# Application URL (injected by runtime or hosting provider)
APP_URL=

# Supabase PostgreSQL (Server-side only — project edykghafxrrvsfbcxnkt)
# Example project URL: https://edykghafxrrvsfbcxnkt.supabase.co
# Leave blank locally to run against the local SQLite dev fallback (data/can-protection.db)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only HMAC-SHA256 key used to hash E.164 normalized phone numbers before DB lookup/storage
# Required (>= 16 chars; 32+ random bytes recommended) whenever SUPABASE_URL / SUPABASE_SECRET_KEY are set
PHONE_LOOKUP_HMAC_KEY=

# OTP Provider Selection: "demo" | "twilio" | "msg91"
# When set to "demo" (or left blank locally), all Twilio and MSG91 variables below are OPTIONAL.
OTP_PROVIDER=demo

# Optional unless OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional unless OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Optional: set to "true" to permit demo OTP when NODE_ENV=production or VERCEL=1
ALLOW_DEV_OTP_DEMO=

# Optional server runtime configuration (recommended in production)
# CAN_SERVER_SECRET=
# CAN_SQLITE_PATH=
# PORT=3000

