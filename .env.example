# CAN Protection Environment Variables Template
# Do NOT commit real secrets to version control.
# NEVER prefix server secrets with VITE_ or expose them to browser code.

# Application URL (injected by runtime or hosting provider)
APP_URL=

# Supabase PostgreSQL (Server-side only — project edykghafxrrvsfbcxnkt)
# Example project URL: https://edykghafxrrvsfbcxnkt.supabase.co
# Leave blank locally to use the local SQLite development database. Production requires Supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only HMAC-SHA256 key used to hash E.164 normalized phone numbers before DB lookup/storage
# Required (>= 16 chars; 32+ random bytes recommended) whenever Supabase is configured.
PHONE_LOOKUP_HMAC_KEY=

# OTP Provider Selection: "demo" | "twilio" | "msg91"
# When set to "demo" (or left blank locally), all Twilio and MSG91 variables below are OPTIONAL.
OTP_PROVIDER=demo

# Optional unless OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional unless OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Required in production: stable random value, at least 32 characters. Never rotate without invalidating active sessions.
CAN_SERVER_SECRET=

# Production is supported only on a single-instance Node host while transient state uses SQLite.
# Set both explicitly on a persistent host; never use this mode on Vercel/serverless.
CAN_ALLOW_PRODUCTION_SQLITE=false
CAN_SQLITE_PATH=

# Server runtime
PORT=3000

